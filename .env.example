# Set a private organizer password to enable /admin.
ADMIN_PASSWORD=

# Optional for local development. Required for persistent hosted storage.
# Apply supabase/schema.sql to your project before supplying these values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set true on non-Vercel hosts to require a database rather than local JSON.
# Vercel always requires Supabase so attendee contacts cannot end up in /tmp.
REQUIRE_DATABASE=false

# Fake guests for local development; set false for the real party.
SEED_DATA=true

# Optional: defaults to .data/party.json locally.
# DATA_FILE=
